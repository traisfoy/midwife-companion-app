# Copy to .env and adjust. Sensible defaults are baked in for local dev.
PORT=4000
DATABASE_URL=postgres://midwife_app:midwife_app@localhost:5432/midwife_companion
JWT_SECRET=dev-only-change-me

# Optional: OpenRouteService API key (free tier: https://openrouteservice.org/dev/#/signup)
# Enables real driving ETAs and address geocoding. Without it the app falls back
# to a straight-line-distance ETA estimate and seeded coordinates.
ORS_API_KEY=

# Optional: VAPID keys for Web Push. If unset, a keypair is generated on first
# boot and persisted to server/.vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
